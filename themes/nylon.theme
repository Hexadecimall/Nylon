# Nylon theme
# Default dark theme.
# Format: key = value. Prefixes: color. (#RRGGBB or #RRGGBBAA), metric. (number), font. (text).

name = Nylon

font.family = system

color.background = #1B1C1E
color.panel = #252628
color.raised = #303235
color.separator = #3A3C40
color.text.primary = #E9EAEC
color.text.secondary = #A6ABB1
color.text.disabled = #63686E
color.accent = #4A8FF0
color.accent.text = #0E1116
color.playhead = #4A8FF0
color.selection = #4A8FF055
color.session.slot = #2C2E31
color.session.slot.hover = #35383C
color.session.stop_button = #4B4F55
color.arrangement.ruler = #222325
color.arrangement.lane = #202123
color.arrangement.lane.alt = #242527
color.arrangement.grid = #2B2D30
color.arrangement.grid.bar = #3A3D41
color.control.background = #3A3D42
color.control.border = #1A1B1D
color.control.text = #E9EAEC
color.control.hover = #454950
color.control.pressed = #2A2C2F
color.control.disabled = #6E7378
color.meter.rms = #6FB37E
color.meter.peak = #C7A24C
color.meter.clip = #C9705C

color.track.1 = #C9705C
color.track.2 = #D08A4E
color.track.3 = #C7A24C
color.track.4 = #9DB35A
color.track.5 = #6FB37E
color.track.6 = #5DAE9E
color.track.7 = #5AA6B8
color.track.8 = #6394C9
color.track.9 = #7E86CF
color.track.10 = #9B7FC7
color.track.11 = #B879B0
color.track.12 = #C46F8E
color.track.13 = #A08C78
color.track.14 = #8E9A8A
color.track.15 = #7F8C99
color.track.16 = #9A948C

metric.separator = 1
metric.control.height = 26
metric.control.padding = 6
metric.transport.height = 38
metric.session.slot.width = 156
metric.session.slot.height = 30
metric.session.scene.count = 8
metric.session.master.width = 128
metric.arrangement.ruler.height = 28
metric.arrangement.lane.height = 72
metric.arrangement.header.width = 220
metric.arrangement.pixels_per_bar = 80
