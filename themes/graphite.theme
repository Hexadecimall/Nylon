# Graphite theme
# Darker theme.
# Format: key = value. Prefixes: color. (#RRGGBB or #RRGGBBAA), metric. (number), font. (text).

name = Graphite

font.family = system

color.background = #0A0B0C
color.panel = #111214
color.raised = #1A1C1F
color.separator = #222427
color.text.primary = #DDDFE1
