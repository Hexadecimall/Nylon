# Slate theme
# Mid-grey theme.
# Format: key = value. Prefixes: color. (#RRGGBB or #RRGGBBAA), metric. (number), font. (text).

name = Slate

font.family = system

color.background = #26282B
color.panel = #303236
color.raised = #3B3E43
color.separator = #45484E
color.text.primary = #E9EAEC
color.text.secondary = #A6ABB1
color.text.disabled = #63686E
color.accent = #4A8FF0
color.accent.text = #0E1116
color.playhead = #4A8FF0
color.selection = #4A8FF055
color.session.slot = #363940
color.session.slot.hover = #40444B
color.session.stop_button = #4B4F55
color.arrangement.ruler = #2C2E32
color.arrangement.lane = #2A2C30
color.arrangement.lane.alt = #2E3034
color.arrangement.grid = #2B2D30
color.arrangement.grid.bar = #3A3D41
color.control.background = #454951
color.control.border = #1A1B1D
color.control.text = #E9EAEC
color.control.hover = #50555D
color.control.pressed = #2A2C2F
color.control.disabled = #6E7378
color.meter.rms = #7ABE89
color.meter.peak = #D2AD57
color.meter.clip = #D47A66

color.track.1 = #CF816F
color.track.2 = #D59762
color.track.3 = #CDAC5F
color.track.4 = #A7BB6B
color.track.5 = #80BC8D
color.track.6 = #6EB7A8
color.track.7 = #6CB0C0
color.track.8 = #76A1D0
color.track.9 = #9197D6
color.track.10 = #A991CF
color.track.11 = #C18ABA
color.track.12 = #CB819C
color.track.13 = #AB9987
color.track.14 = #9BA698
color.track.15 = #8D99A4
color.track.16 = #A6A19A

metric.separator = 1
metric.control.height = 26
metric.control.padding = 6
metric.transport.height = 38
metric.session.slot.width = 156
metric.session.slot.height = 30
metric.session.scene.count = 8
metric.session.master.width = 128
metric.arrangement.ruler.height = 28
metric.arrangement.lane.height = 72
metric.arrangement.header.width = 220
metric.arrangement.pixels_per_bar = 80
metric.arrangement.bars = 64
metric.font.size = 13
metric.text.inset = 4
metric.transport.spacing = 8
metric.transport.tempo.width = 96
metric.session.header.band = 2
metric.session.stop.size = 5
metric.session.stop.inset = 3
metric.arrangement.header.band = 3

# Panels and controls
color.state.on = #DEC263
color.state.solo = #66BDCF
color.state.arm = #DA7474
color.state.play = #83BE90
color.state.record = #DA7474
color.state.loop = #78AEF8
color.browser.background = #2B2D31
color.browser.selection = #33363B
color.browser.header = #303236
color.detail.background = #2B2D31
color.mixer.background = #303236
color.fader.track = #141517
color.fader.fill = #4A4E54
color.fader.handle = #D6D9DD
color.knob.track = #1A1B1D
color.knob.arc = #D6D9DD
color.meter.background = #141517
color.track.text = #0F1113
color.lcd.background = #0F1114
color.lcd.text = #CFE3FF
color.lcd.dim = #5A6B80
color.clip.empty.hover = #40444B

metric.browser.width = 300
metric.detail.height = 260
metric.detail.width = 260
metric.mixer.height = 260
metric.fader.width = 14
metric.fader.handle.height = 8
metric.knob.size = 28
metric.meter.channel.width = 4
metric.meter.clip.height = 4
metric.strip.button.height = 20
metric.transport.button.size = 28

# Window chrome
color.window.border = #3A3C40
color.titlebar.background = #1F2124
color.panel.border = #151617
color.window.control.close = #D47A66
color.window.control.minimize = #D2AD57
color.window.control.zoom = #7ABE89

metric.radius = 9
metric.radius.small = 6
metric.panel.gap = 4
metric.panel.padding = 8
metric.titlebar.height = 38
metric.window.border = 1
metric.window.control.size = 13
metric.lcd.width = 360
